# Copy to .env and adjust. .env is gitignored — never commit it.

# Which demo object is active (a folder name under objects/)
ARSA_OBJECT=siemens-dishwasher

# LAN IP of THIS machine (the edge server). The headset connects here.
# Windows: run `ipconfig` and take the IPv4 of your Wi-Fi/Ethernet adapter.
# WSL2: this must be the WINDOWS host IP, not the WSL IP.
ARSA_HOST_IP=192.168.1.50
ARSA_PORT=8000

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
ARSA_VLM_MODEL=qwen3-vl:8b
ARSA_EMBED_MODEL=bge-m3

# Safety thresholds — see ADR-0006
ARSA_MIN_PART_CONFIDENCE=0.65
ARSA_MIN_RETRIEVAL_SCORE=0.35

# Postgres
POSTGRES_USER=arsa
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arsa
