# =============================================================================
# Unity  —  ONLY Assets/, Packages/ and ProjectSettings/ belong in git.
# Everything below is regenerated by the editor and must never be committed.
# =============================================================================
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/Assets/AssetStoreTools*
unity/Assets/Plugins/Editor/JetBrains*
unity/.vs/
unity/.gradle/
unity/ExportedObj/
unity/*.apk
unity/*.aab
unity/*.unitypackage
unity/*.app
# Auto-generated solution / project files
unity/*.csproj
unity/*.sln
unity/*.unityproj
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
# Crash reports
unity/sysinfo.txt
unity/crashlytics-build.properties

# =============================================================================
# Model weights, manuals, media  —  NEVER commit these.
# Models are pulled by ollama. Manuals are fetched by `make ingest`.
# =============================================================================
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
data/manuals/
data/cache/
objects/*/manual/
!objects/*/object.yaml

# Reference photos: keep them, but they must be resized JPEGs (see docs).
# If a reference photo is > 500 KB, resize it instead of adding an exception.

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# =============================================================================
# Secrets & local config
# =============================================================================
.env
.env.local
*.pem
*.keystore
*.jks
unity/keystore/

# =============================================================================
# Runtime artefacts
# =============================================================================
tools/perf/out/
tools/net/captures/*.pcap
docs/benchmarks/raw/*.json
!docs/benchmarks/raw/.gitkeep

# =============================================================================
# OS / editor
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
